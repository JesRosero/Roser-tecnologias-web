rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isRoserAdmin() {
      return request.auth != null && request.auth.uid == 'UNVzgzxtFFPP52WaOImlzrMRhiV2';
    }
    match /businesses/{businessId} {
      allow read, write: if isRoserAdmin();
      match /products/{productId} {
        allow read, write: if isRoserAdmin();
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
